{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raulcarini-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "ratelimits": [
    {
      "name": "PAGE_VIEWS_READ_RATE_LIMITER",
      "namespace_id": "731001",
      "simple": {
        "limit": 2,
        "period": 10,
      },
    },
    {
      "name": "PAGE_VIEWS_WRITE_RATE_LIMITER",
      "namespace_id": "731002",
      "simple": {
        "limit": 5,
        "period": 10,
      },
    },
  ],
  "routes": [
    {
      "pattern": "raulcarini.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.raulcarini.dev",
      "custom_domain": true,
    },
  ],
  "secrets": {
    "required": ["UPSTASH_REDIS_REST_URL", "UPSTASH_REDIS_REST_TOKEN"],
  },
}
