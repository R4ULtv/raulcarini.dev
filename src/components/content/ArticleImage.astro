---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
    src: ImageMetadata;
    alt?: string;
}

const { src, alt = "", ...attributes } = Astro.props;
const width = Math.min(src.width, 720);
---

<Image {...attributes} src={src} {alt} {width} format="webp" quality={85} />
